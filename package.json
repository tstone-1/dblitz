{
  "name": "dblitz",
  "version": "26.9.4",
  "description": "Read-only SQLite browser",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "check": "svelte-kit sync && node scripts/svelte-check.mjs --tsconfig ./tsconfig.json --tsgo",
    "quality": "npm run check && npm test && npm run build && cd src-tauri && cargo fmt --check && cargo test && cargo clippy --all-targets --all-features -- -D warnings",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.7.4",
    "tslib": "^2.8.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dblitz",
  "version": "26.7.6",
  "identifier": "com.tstone.dblitz",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "dblitz - SQLite Browser",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlBOTA1NUQ0NTlCRTkxQzAKUldUQWtiNVoxRldRbXVMZEFhVGl0cnBHWUV2T3dxSmREQ3BLcTFwVDhPci84VWsyRmRTZ1RNVnUK",
      "endpoints": [
        "https://github.com/tstone-1/dblitz/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["db", "sqlite", "sqlite3", "db3"],
        "mimeType": "application/x-sqlite3",
        "description": "SQLite Database"
      }
    ]
  }
}

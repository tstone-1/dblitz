#!/bin/sh
# pre-push hook for public repositories.
# Blocks pushes that would leak internal-only content into GitHub by calling
# the public-safe audit in agent-memory/bin/audit-agent-memory.ps1.
#
# Activate per-clone with: git config core.hooksPath .githooks
# Skip a single push (rare, use with care): SKIP_AGENT_MEMORY_AUDIT=1 git push

set -eu
export GIT_NO_REPLACE_OBJECTS=1

if [ "${SKIP_AGENT_MEMORY_AUDIT:-}" = "1" ]; then
    echo "[pre-push] SKIP_AGENT_MEMORY_AUDIT=1 -- skipping public-safe audit."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
AUDIT=""

# Search the canonical agent-memory clone locations.
# Windows flat layout: $USERPROFILE/agent-memory/
# macOS hierarchical:  $HOME/Developer/github.com/tstone-1/agent-memory/
for candidate in \
    "${USERPROFILE:-}/agent-memory/bin/audit-agent-memory.ps1" \
    "$HOME/agent-memory/bin/audit-agent-memory.ps1" \
    "$HOME/Developer/github.com/tstone-1/agent-memory/bin/audit-agent-memory.ps1"; do
    case "$candidate" in /*|*:*) ;; *) continue ;; esac
    if [ -f "$candidate" ]; then
        AUDIT="$candidate"
        break
    fi
done

if [ -z "$AUDIT" ]; then
    echo "[pre-push] ERROR: audit script not found in any known location."
    echo "[pre-push] Looked for agent-memory/bin/audit-agent-memory.ps1 under:"
    echo "[pre-push]   \$USERPROFILE, \$HOME, \$HOME/Developer/github.com/tstone-1"
    echo "[pre-push] Push BLOCKED. Clone agent-memory or override with SKIP_AGENT_MEMORY_AUDIT=1."
    exit 1
fi

# Prints the audit script's `$ForbiddenPatterns` as POSIX extended regular
# expressions, one per line. The patterns live only in that private script:
# this file is public, so it carries none of them, in any spelling.
#
# The array is read strictly: every line between `$ForbiddenPatterns = @(` and
# the closing `)` must be blank, a comment, or one single-quoted string with an
# optional trailing comma. A line of any other shape, a regex construct that
# has no POSIX equivalent here, or an empty list fails the read, so a change
# to the script's layout blocks the push instead of silently dropping
# patterns. `\s`, `\d` and `\w` are rewritten to POSIX classes; `\b` is kept:
# it is an extension that GNU grep reads (measured), and the fallback this
# replaces relied on it too. Not measured on macOS grep.
read_forbidden_patterns() {
    tr -d '\r' < "$1" | awk '
        BEGIN { sq = sprintf("%c", 39); state = 0; n = 0; bad = "" }
        state == 0 && $0 ~ /^\$ForbiddenPatterns = @\($/ { state = 1; next }
        state == 1 && $0 ~ /^\)$/ { state = 2; next }
        state != 1 { next }
        {
            line = $0
            sub(/^[ \t]+/, "", line)
            if (line == "" || substr(line, 1, 1) == "#") next
            if (substr(line, 1, 1) != sq) { bad = "unquoted line " NR; exit }
            # A single-quoted PowerShell string, where a doubled quote stands
            # for one quote.
            lit = ""; i = 2; closed = 0
            while (i <= length(line)) {
                c = substr(line, i, 1)
                if (c == sq) {
                    if (substr(line, i + 1, 1) == sq) { lit = lit sq; i += 2; continue }
                    closed = 1; i++; break
                }
                lit = lit c; i++
            }
            rest = substr(line, i)
            if (!closed || rest !~ /^,?[ \t]*(#.*)?$/) { bad = "line " NR " is not one quoted string"; exit }
            # Translate to POSIX ERE, refusing anything this cannot express.
            out = ""; j = 1
            while (j <= length(lit)) {
                c = substr(lit, j, 1)
                if (c == "\\") {
                    d = substr(lit, j + 1, 1)
                    if (d == "s") out = out "[[:space:]]"
                    else if (d == "d") out = out "[0-9]"
                    else if (d == "w") out = out "[[:alnum:]_]"
                    else if (d != "" && index("-@/", d) > 0) out = out d
                    else if (d != "" && index(".b\\()[]{}+*?|^$", d) > 0) out = out c d
                    else { bad = "line " NR " uses an escape POSIX grep lacks"; exit }
                    j += 2; continue
                }
                if (c == "[" || (c == "(" && substr(lit, j + 1, 1) == "?")) {
                    bad = "line " NR " uses a construct this reader does not translate"; exit
                }
                out = out c; j++
            }
            if (out == "") { bad = "line " NR " is an empty pattern"; exit }
            pat[++n] = out
        }
        END {
            if (bad == "" && state != 2) bad = "no complete $ForbiddenPatterns block"
            if (bad == "" && n == 0) bad = "the $ForbiddenPatterns block is empty"
            if (bad != "") { print "[pre-push] cannot read the patterns: " bad > "/dev/stderr"; exit 1 }
            for (k = 1; k <= n; k++) print pat[k]
        }'
}

# Check the same committed content with and without PowerShell. Keep private
# expressions outside the repository and never print a match or its contents.
blocked() {
    echo "[pre-push] Push BLOCKED. $1" >&2
    exit 1
}

[ -n "$REPO_ROOT" ] || blocked "Cannot find the repository."
scratch=$(mktemp -d) || blocked "Cannot create a temporary audit directory."
trap 'rm -rf "$scratch"' 0
trap 'exit 1' HUP INT TERM
read_forbidden_patterns "$AUDIT" > "$scratch/patterns" || blocked "Cannot read the private pattern list."

# The hook receives one line per ref. Git supplies an all-zero old ID for a
# new ref, so use the remote's advertised history as its lower bound. Local
# remote-tracking refs can be stale or absent. An unrecognised remote commit
# can safely be omitted from the exclusions; that only scans more history.
: > "$scratch/revisions"
: > "$scratch/trees"
: > "$scratch/blobs"
new_ref=false
exclude_published_commit() {
    if commit=$(git rev-parse --verify --quiet "$1^{commit}"); then
        printf '^%s\n' "$commit" >> "$scratch/revisions"
    fi
}
while read -r local_ref local_oid remote_ref remote_oid extra; do
    case "$local_oid:$remote_oid" in
        *[!0-9a-f:]*|:*|*:) blocked "Invalid object ID in ref update." ;;
    esac
    [ -n "$local_ref" ] && [ -n "$remote_ref" ] && [ -z "$extra" ] || blocked "Invalid ref update."
    case "$remote_oid" in *[!0]*) exclude_published_commit "$remote_oid" ;; esac
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    case "$remote_oid" in *[!0]*) ;; *) new_ref=true ;; esac
    target=$(git rev-parse --verify "$local_oid^{}") || blocked "Cannot resolve $local_ref."
    kind=$(git cat-file -t "$target") || blocked "Cannot read $local_ref."
    case "$kind" in
        commit)
            printf '%s\n' "$target" >> "$scratch/revisions"
            git rev-parse --verify "$target^{tree}" >> "$scratch/trees" || blocked "Cannot read the outgoing tree."
            ;;
        tree) printf '%s\n' "$target" >> "$scratch/trees" ;;
        blob) printf '%s\n' "$target" >> "$scratch/blobs" ;;
        *) blocked "Unsupported outgoing object." ;;
    esac
done

if [ "$new_ref" = true ]; then
    git ls-remote --refs -- "${2:?missing push destination}" > "$scratch/advertised" 2> "$scratch/errors" || blocked "Cannot determine existing remote history."
    while read -r oid ref; do
        exclude_published_commit "$oid"
    done < "$scratch/advertised"
fi
git rev-list --format=%T --no-commit-header --stdin < "$scratch/revisions" >> "$scratch/trees" || blocked "Cannot enumerate outgoing history."
awk '!seen[$0]++' "$scratch/trees" > "$scratch/unique-trees" || blocked "Cannot enumerate outgoing trees."

# Scan whole trees, including scripts with unusual names and files restored
# from already-published history. Checking stderr also catches partial reads
# reported by git grep alongside its ordinary no-match exit code.
while IFS= read -r tree; do
    status=0
    git -C "$REPO_ROOT" grep --threads=1 -a -ilE --no-textconv -f "$scratch/patterns" "$tree" -- > /dev/null 2> "$scratch/errors" || status=$?
    [ ! -s "$scratch/errors" ] || blocked "Cannot search tree $tree."
    case "$status" in
        0) blocked "Tree $tree contains a forbidden public-repo pattern." ;;
        1) ;;
        *) blocked "Cannot search tree $tree." ;;
    esac
done < "$scratch/unique-trees"

# Tags can point directly at a blob as well as at a commit or tree.
while IFS= read -r blob; do
    git cat-file blob "$blob" > "$scratch/blob" || blocked "Cannot read blob $blob."
    status=0
    grep -Eil -f "$scratch/patterns" "$scratch/blob" > /dev/null 2> "$scratch/errors" || status=$?
    [ ! -s "$scratch/errors" ] || blocked "Cannot search blob $blob."
    case "$status" in
        0) blocked "Blob $blob contains a forbidden public-repo pattern." ;;
        1) ;;
        *) blocked "Cannot search blob $blob." ;;
    esac
done < "$scratch/blobs"

if command -v pwsh >/dev/null 2>&1 && grep -q '^[^^]' "$scratch/revisions"; then
    # The private checker reads a checkout and infers outgoing messages from
    # local branches and remote refs. Give it exactly the proposed revisions.
    objects=$(git rev-parse --path-format=absolute --git-path objects) || blocked "Cannot locate outgoing objects."
    local_env=$(git rev-parse --local-env-vars) || blocked "Cannot isolate audit environment."
    (
        unset $local_env
        audit_repo="$scratch/checkout"
        git init -q "$audit_repo" || exit 1
        printf '%s\n' "$objects" > "$audit_repo/.git/objects/info/alternates" || exit 1
        while read -r rev; do
            case "$rev" in
                ^*) oid=${rev#^}; ref="refs/remotes/published/$oid" ;;
                *) oid=$rev; ref="refs/heads/outgoing/$oid" ;;
            esac
            git -C "$audit_repo" update-ref "$ref" "$oid" || exit 1
        done < "$scratch/revisions"
        while read -r tip; do
            case "$tip" in ^*) continue ;; esac
            git -C "$audit_repo" -c core.hooksPath=/dev/null read-tree --reset -u "$tip" || exit 1
            pwsh -NoProfile -ExecutionPolicy Bypass -File "$AUDIT" -CheckPublicSafe -CheckRepoPath "$audit_repo" || exit 1
        done < "$scratch/revisions"
    ) > /dev/null 2>&1 || blocked "Private audit of outgoing revisions failed."
fi
echo "[pre-push] OK - outgoing content passed the public-safe check."

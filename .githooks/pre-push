#!/bin/sh
# pre-push hook for public repositories.
# Blocks pushes that would leak internal-only content into GitHub by calling
# the public-safe audit in agent-memory/bin/audit-agent-memory.ps1.
#
# Activate per-clone with: git config core.hooksPath .githooks
# Skip a single push (rare, use with care): SKIP_AGENT_MEMORY_AUDIT=1 git push

set -u

if [ "${SKIP_AGENT_MEMORY_AUDIT:-}" = "1" ]; then
    echo "[pre-push] SKIP_AGENT_MEMORY_AUDIT=1 -- skipping public-safe audit."
    exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
AUDIT=""

# Search the canonical agent-memory clone locations.
# Windows flat layout: $USERPROFILE/agent-memory/
# macOS hierarchical:  $HOME/Developer/github.com/tstone-1/agent-memory/
for candidate in \
    "${USERPROFILE:-}/agent-memory/bin/audit-agent-memory.ps1" \
    "$HOME/agent-memory/bin/audit-agent-memory.ps1" \
    "$HOME/Developer/github.com/tstone-1/agent-memory/bin/audit-agent-memory.ps1"; do
    case "$candidate" in /*|*:*) ;; *) continue ;; esac
    if [ -f "$candidate" ]; then
        AUDIT="$candidate"
        break
    fi
done

if [ -z "$AUDIT" ]; then
    echo "[pre-push] ERROR: audit script not found in any known location."
    echo "[pre-push] Looked for agent-memory/bin/audit-agent-memory.ps1 under:"
    echo "[pre-push]   \$USERPROFILE, \$HOME, \$HOME/Developer/github.com/tstone-1"
    echo "[pre-push] Push BLOCKED. Clone agent-memory or override with SKIP_AGENT_MEMORY_AUDIT=1."
    exit 1
fi

# Prints the audit script's `$ForbiddenPatterns` as POSIX extended regular
# expressions, one per line. The patterns live only in that private script:
# this file is public, so it carries none of them, in any spelling.
#
# The array is read strictly: every line between `$ForbiddenPatterns = @(` and
# the closing `)` must be blank, a comment, or one single-quoted string with an
# optional trailing comma. A line of any other shape, a regex construct that
# has no POSIX equivalent here, or an empty list fails the read, so a change
# to the script's layout blocks the push instead of silently dropping
# patterns. `\s`, `\d` and `\w` are rewritten to POSIX classes; `\b` is kept:
# it is an extension that GNU grep reads (measured), and the fallback this
# replaces relied on it too. Not measured on macOS grep.
read_forbidden_patterns() {
    tr -d '\r' < "$1" | awk '
        BEGIN { sq = sprintf("%c", 39); state = 0; n = 0; bad = "" }
        state == 0 && $0 ~ /^\$ForbiddenPatterns = @\($/ { state = 1; next }
        state == 1 && $0 ~ /^\)$/ { state = 2; next }
        state != 1 { next }
        {
            line = $0
            sub(/^[ \t]+/, "", line)
            if (line == "" || substr(line, 1, 1) == "#") next
            if (substr(line, 1, 1) != sq) { bad = "unquoted line " NR; exit }
            # A single-quoted PowerShell string, where a doubled quote stands
            # for one quote.
            lit = ""; i = 2; closed = 0
            while (i <= length(line)) {
                c = substr(line, i, 1)
                if (c == sq) {
                    if (substr(line, i + 1, 1) == sq) { lit = lit sq; i += 2; continue }
                    closed = 1; i++; break
                }
                lit = lit c; i++
            }
            rest = substr(line, i)
            if (!closed || rest !~ /^,?[ \t]*(#.*)?$/) { bad = "line " NR " is not one quoted string"; exit }
            # Translate to POSIX ERE, refusing anything this cannot express.
            out = ""; j = 1
            while (j <= length(lit)) {
                c = substr(lit, j, 1)
                if (c == "\\") {
                    d = substr(lit, j + 1, 1)
                    if (d == "s") out = out "[[:space:]]"
                    else if (d == "d") out = out "[0-9]"
                    else if (d == "w") out = out "[[:alnum:]_]"
                    else if (d != "" && index("-@/", d) > 0) out = out d
                    else if (d != "" && index(".b\\()[]{}+*?|^$", d) > 0) out = out c d
                    else { bad = "line " NR " uses an escape POSIX grep lacks"; exit }
                    j += 2; continue
                }
                if (c == "[" || (c == "(" && substr(lit, j + 1, 1) == "?")) {
                    bad = "line " NR " uses a construct this reader does not translate"; exit
                }
                out = out c; j++
            }
            if (out == "") { bad = "line " NR " is an empty pattern"; exit }
            pat[++n] = out
        }
        END {
            if (bad == "" && state != 2) bad = "no complete $ForbiddenPatterns block"
            if (bad == "" && n == 0) bad = "the $ForbiddenPatterns block is empty"
            if (bad != "") { print "[pre-push] cannot read the patterns: " bad > "/dev/stderr"; exit 1 }
            for (k = 1; k <= n; k++) print pat[k]
        }'
}

public_safe_fallback() {
    echo "[pre-push] pwsh not found; running POSIX public-safe fallback."

    if ! forbidden_patterns=$(read_forbidden_patterns "$AUDIT"); then
        echo "[pre-push] Push BLOCKED. Install PowerShell 7 (pwsh), or override with SKIP_AGENT_MEMORY_AUDIT=1."
        return 1
    fi
    count=$(printf '%s\n' "$forbidden_patterns" | grep -c .)
    echo "[pre-push] read $count patterns from $AUDIT"

    scan_file() {
        case "$1" in
            *.md|*.txt|*.rst|*.adoc|*.json|*.toml|*.yaml|*.yml|*.ini|*.cfg|*.conf|*.ps1|*.psm1|*.sh|*.bash|*.zsh|*.py|*.pyi|*.rs|*.go|*.js|*.ts|*.jsx|*.tsx|*.svelte|*.vue|*.html|*.css|*.scss|*.sql|*.gitignore|*.gitattributes|Dockerfile|Makefile)
                return 0
                ;;
            *)
                return 1
                ;;
        esac
    }

    # The file list is taken first and checked: piped straight into the loop,
    # a failing or missing git gave the loop nothing to read and the check
    # printed OK having scanned no file.
    if [ -z "$REPO_ROOT" ] || ! tracked=$(git -C "$REPO_ROOT" ls-files) || [ -z "$tracked" ]; then
        echo "[public-safe-check] cannot list the tracked files. Push BLOCKED."
        return 1
    fi

    hits=0
    printf '%s\n' "$tracked" | while IFS= read -r rel; do
        [ -f "$REPO_ROOT/$rel" ] || continue
        scan_file "$rel" || continue

        printf '%s\n' "$forbidden_patterns" | while IFS= read -r pat; do
            if grep -Eiq -- "$pat" "$REPO_ROOT/$rel"; then
                echo "[public-safe-check] BLOCKED: $rel matches forbidden public-repo pattern."
                exit 3
            fi
        done || exit 3
    done || hits=$?

    if [ "$hits" -ne 0 ]; then
        echo "[public-safe-check] Push BLOCKED."
        return 1
    fi

    echo "[public-safe-check] OK - no forbidden tokens found."
    return 0
}

if ! command -v pwsh >/dev/null 2>&1; then
    public_safe_fallback
    exit $?
fi

pwsh -NoProfile -ExecutionPolicy Bypass -File "$AUDIT" -CheckPublicSafe -CheckRepoPath "$REPO_ROOT"
exit $?
